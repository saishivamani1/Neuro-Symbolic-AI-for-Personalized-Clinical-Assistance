# ==============================================================================
# .env.example
# Neuro-Symbolic Healthcare Intelligence Platform
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ==============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Neuro-Symbolic Healthcare Intelligence Platform"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
APP_VERSION=0.1.0

# ---- LLM Provider ------------------------------------------------------------
# Supported: openai | groq | ollama | azure_openai
LLM_PROVIDER=openai

# OpenAI (or OpenAI-compatible API)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Groq (Llama & Mistral models) — when LLM_PROVIDER=groq
# Popular Models:
#   LLaMA:   llama-3.3-70b-versatile | llama-3.1-8b-instant | llama3-70b-8192 | llama3-8b-8192
#   Mistral: mixtral-8x7b-32768 | mistral-saba-24b
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama / Local Llama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embeddings --------------------------------------------------------------
# BGE Large English model (recommended for medical text)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Use "cuda" if a GPU is available; "cpu" otherwise
EMBEDDING_DEVICE=cpu

# ---- ChromaDB ----------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=medical_documents

# ---- Neo4j Knowledge Graph ---------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ---- RAG / Retrieval ---------------------------------------------------------
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---- Logging -----------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Format: json | text
LOG_FORMAT=json

# ---- Paths -------------------------------------------------------------------
DATA_DIRECTORY=./data
DOCUMENTS_DIRECTORY=./data/documents
SAMPLE_DIRECTORY=./data/sample
RULES_CONFIG_PATH=./data/rules.json
